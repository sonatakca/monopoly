# Default: normalize to LF in repo
*               text=auto eol=lf

# Common source files (force text+LF)
*.ts            text eol=lf
*.tsx           text eol=lf
*.js            text eol=lf
*.jsx           text eol=lf
*.json          text eol=lf
*.css           text eol=lf
*.scss          text eol=lf
*.md            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

# Binary assets (no line-ending changes, no diffs)
*.glb           binary
*.gltf          binary
*.stl           binary
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.webp          binary
*.ico           binary
*.pdf           binary
*.zip           binary

# Scripts
*.sh            text eol=lf
*.ps1           text eol=crlf
*.bat           text eol=crlf
*.cmd           text eol=crlf
